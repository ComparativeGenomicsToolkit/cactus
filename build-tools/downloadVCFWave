#!/bin/bash
# Build vcfwave and the other vcflib tools cactus uses (vcffixup, ...) into bin/.
# downloadPangenomeTools runs it, so they are in the docker image and the binary release.  On
# Linux they are fully static, so they never depend on finding the right libvcflib.so (through
# LD_LIBRARY_PATH, or one a system happens to have installed) at run time.  Mac cannot link fully
# static binaries, so there they stay dynamic, with their libraries in lib/.

set -beEu -o pipefail

# Note: this bit below should be kept consistent with downloadPangenomeTools
pangenomeBuildDir=$(pwd)/build-pangenome-tools
binDir=$(pwd)/bin
libDir=$(pwd)/lib
# just use cactusRootPath for now
dataDir=$(pwd)/src/cactus
CWD=$(pwd)

# CPU baseline.  include.mk is the single source of truth; ask make for it rather than
# duplicating the arm/legacy/x86 selection here, where it would silently drift.
# MAKEFLAGS is cleared because "make binRelease" reaches this from inside a make recipe.
CACTUS_ARCH_FLAGS="${CACTUS_ARCH_FLAGS:-$(env -u MAKEFLAGS make -s -C "${CWD}" arch-flags)}"
if [ -z "${CACTUS_ARCH_FLAGS}" ]; then
    echo "ERROR: 'make arch-flags' returned nothing; cannot determine the CPU baseline." >&2
    exit 1
fi
# vcflib's RelWithDebInfo supplies its own -O2, so unlike the other download scripts this one
# does not need to pick an optimisation level, only to hand over the baseline.
export CFLAGS="${CFLAGS:-} ${CACTUS_ARCH_FLAGS}"
export CXXFLAGS="${CXXFLAGS:-} ${CACTUS_ARCH_FLAGS}"
# works on MacOS and Linux
if [ -z ${numcpu+x} ]; then
	 numcpu=$(getconf _NPROCESSORS_ONLN)
fi

# Mac: Homebrew's prefix (htslib, ...) is not on Apple clang's default search paths, and CMake's
# FindOpenMP cannot find Homebrew's keg-only libomp for Apple clang by itself
isMac=0
if [[ "$(uname -s)" == "Darwin" ]]; then
	 isMac=1
	 brewPrefix=$(brew --prefix)
	 export CPPFLAGS="${CPPFLAGS:-} -I${brewPrefix}/include"
	 export LDFLAGS="${LDFLAGS:-} -L${brewPrefix}/lib"
	 ompPrefix=$(brew --prefix libomp)
	 ompFlags="-Xpreprocessor -fopenmp -I${ompPrefix}/include"
fi
# CMake 4 refuses projects that ask for compatibility with CMake < 3.5.  Older CMakes ignore this.
export CMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM:-3.5}

set -x
rm -rf ${pangenomeBuildDir}
mkdir -p ${pangenomeBuildDir}
mkdir -p ${binDir}
mkdir -p ${libDir}

cd ${pangenomeBuildDir}
git clone --recursive https://github.com/glennhickey/vcflib.git
cd vcflib
# safe-left-shift branch (glennhickey/vcflib PR #3), for vcfleftshift
git checkout e28ad6112ceccc789d36fb5371e0d481211a9365
mkdir build
cd build
# RelWithDebInfo, not Debug: Debug is -g with no -O, which built vcffixup, vcfwave and the
# bundled WFA2-lib (vcfwave's alignment engine, an add_subdirectory so it inherits this) at
# -O0.  Measured: vcffixup over 120k records x 60 samples, 53.2s at Debug vs 14.5s at
# RelWithDebInfo, byte-identical output.  Not Release -- that injects -march=native
# (vcflib CMakeLists.txt:100-101), which we cannot ship.  vcflib's own CMakeLists.txt:4
# recommends RelWithDebInfo.
# Mac, BUILD_SHARED_LIBS=ON: vcflib's CMakeLists.txt no longer turns it on for a dynamic build, so
# without it libvcflib is built static and there is no libvcflib.dylib to install below.
# Linux, BUILD_STATIC=ON: links WFA2-lib and vcflib's own htslib (built without libcurl) statically.
tools="vcfwave vcfcreatemulti vcfbreakmulti vcfuniq vcffixup vcfleftshift"
if [[ $isMac -eq 1 ]]
then
	 cmake -DZIG=OFF -DWFA_GITMODULE=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_SHARED_LIBS=ON \
		  -DOpenMP_C_FLAGS="${ompFlags}" -DOpenMP_C_LIB_NAMES=omp \
		  -DOpenMP_CXX_FLAGS="${ompFlags}" -DOpenMP_CXX_LIB_NAMES=omp \
		  -DOpenMP_omp_LIBRARY=${ompPrefix}/lib/libomp.dylib ..
	 cmake --build . -- -j ${numcpu}
else
	 # BUILD_STATIC does the static linking itself, so vcflib gets the CPU baseline and nothing
	 # else.  makeBinRelease exports -static in CFLAGS, CXXFLAGS, LDFLAGS and LIBS for everything
	 # else, and with it CMake's library checks (FindLibLZMA, ...) fail: they link a test program
	 # against the shared library they found before vcflib switches to .a files.  The bundled
	 # htslib runs its configure during the build, so the build gets the same flags.
	 (export CFLAGS="${CACTUS_ARCH_FLAGS}" CXXFLAGS="${CACTUS_ARCH_FLAGS}" LDFLAGS="" LIBS=""
	  cmake -DZIG=OFF -DWFA_GITMODULE=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo -DBUILD_STATIC=ON .. && \
		  cmake --build . -- -j ${numcpu})
fi
if [[ $isMac -eq 1 ]]
then
	 mv ${tools} ${binDir}
	 # The tools find libvcflib and libwfa2 through rpaths into this build directory.  Copy the
	 # libraries to ${libDir}, point the rpaths there instead, and re-sign, since changing the
	 # load commands invalidates the signature.
	 cp -L libvcflib.dylib contrib/WFA2-lib/libwfa2.0.dylib ${libDir}
	 for tool in ${tools}
	 do
		  for rpath in $(otool -l ${binDir}/${tool} | awk '$1 == "path" {print $2}')
		  do
				install_name_tool -delete_rpath ${rpath} ${binDir}/${tool}
		  done
		  install_name_tool -add_rpath @executable_path/../lib ${binDir}/${tool}
		  codesign --force -s - ${binDir}/${tool}
	 done
else
	 for tool in ${tools}
	 do
		  if [[ $(ldd ${tool} | grep so | wc -l) -ne 0 ]]
		  then
				echo "ERROR: ${tool} is not statically linked" >&2
				exit 1
		  fi
	 done
	 mv ${tools} ${binDir}
fi
 
cd ${CWD}
rm -rf ${pangenomeBuildDir}
