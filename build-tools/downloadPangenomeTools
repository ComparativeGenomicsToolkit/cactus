# Pull one binary out of a bioconda package into ${binDir}.  A .conda package is a zip of
# zstd-compressed tarballs (python's zipfile avoids needing the unzip tool; zstd is needed to
# decompress the inner tarball) and a .tar.bz2 one is the tarball itself.
# (bumping a version: the filenames include bioconda's build hash, which differs per platform)
condaBinary() {
	 local url=$1
	 local tool=$2
	 local pkg=$(basename ${url})
	 wget -nv --tries=5 --waitretry=3 --timeout=60 --retry-connrefused ${url}
	 mkdir -p ${tool}-conda
	 if [[ ${pkg} == *.conda ]]
	 then
		  python3 -c "import sys,zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" ${pkg} ${tool}-conda
		  zstd -d -f ${tool}-conda/pkg-${tool}-*.tar.zst -o ${tool}-conda/${tool}-pkg.tar
		  tar --no-same-owner -xf ${tool}-conda/${tool}-pkg.tar -C ${tool}-conda bin/${tool}
	 else
		  tar --no-same-owner -xjf ${pkg} -C ${tool}-conda bin/${tool}
	 fi
	 mv ${tool}-conda/bin/${tool} ${binDir}
}

# The Mac builds of gfaffix, vcfbub and panacus come from bioconda too.  They link only system
# libraries.  vcfbub is 0.1.2 there, because bioconda has no 0.1.1 for Apple Silicon.  0.1.2 only
# changes Cargo dependency pins (its src/main.rs and bundled htslib are the same), so it filters
# exactly like the Linux 0.1.1 static release.
