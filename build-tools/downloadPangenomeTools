else
	 exit 1
fi

#bedtools
cd ${pangenomeBuildDir}
if [[ $isMac -eq 1 ]]
then
	 # the release binary is for Linux
	 wget -nv --tries=5 --waitretry=3 --timeout=60 --retry-connrefused https://github.com/arq5x/bedtools2/releases/download/v2.31.0/bedtools-2.31.0.tar.gz
	 tar --no-same-owner -xzf bedtools-2.31.0.tar.gz
	 make -C bedtools2 -j ${numcpu}
	 mv bedtools2/bin/bedtools bedtools
else
