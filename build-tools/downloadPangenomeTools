fi
# rgfa-zip (<graphmap zipAlleles>) runs minimap2 itself, always the one cactus puts in ${binDir} above
if [[ $STATIC_CHECK -ne 1 || $(ldd rgfa-zip | grep so | wc -l) -eq 0 ]]
then
