# odgi
cd ${pangenomeBuildDir}
wget -nv --tries=5 --waitretry=3 --timeout=60 --retry-connrefused https://github.com/pangenome/odgi/releases/download/v0.9.4/odgi-v0.9.4.tar.gz
tar --no-same-owner -zxf odgi-v0.9.4.tar.gz
cd odgi-v0.9.4
# "Generic" is odgi's portable build type -- it exists to dodge the -Ofast -march=native
# that CMAKE_BUILD_TYPE=Release injects (odgi CMakeLists.txt:77-91).  But odgi only sets
# CMAKE_CXX_FLAGS under Release/RelWithDebInfo, and CMake has no CMAKE_CXX_FLAGS_GENERIC of
# its own, so Generic ended up with no -O flag at all and odgi shipped at -O0.  Supplying
# CMAKE_CXX_FLAGS_GENERIC adds -O3 for that config only; overriding CMAKE_CXX_FLAGS instead
# would drop the -fopenmp that Generic does supply through it.
if [[ $STATIC_CHECK -eq 1 ]]
then
    CXXFLAGS="" CFLAGS="" LDFLAGS="" LIBS="" cmake -DBUILD_STATIC=1 -DCMAKE_BUILD_TYPE=Generic -DCMAKE_C_FLAGS_GENERIC="-O3 ${CACTUS_ARCH_FLAGS}" -DCMAKE_CXX_FLAGS_GENERIC="-O3 ${CACTUS_ARCH_FLAGS}" -H. -Bbuild && CXXFLAGS="" CFLAGS="" LDFLAGS="" LIBS="" cmake --build build -- -j ${numcpu}
elif [[ $isMac -eq 1 ]]
then
    # Apple clang needs some help with odgi and what it bundles:
    # - sdsl-lite only recognizes clang by a "clang" compiler path or a "Clang" id, and takes
    #   /usr/bin/c++ ("AppleClang") for MSVC, so name clang outright.  Its ExternalProject reads
    #   CC and CXX when it configures, during the build step, so they stay set for that too.
    # - the same sdsl-lite has a louds_tree::swap bug current clang rejects (vgteam/sdsl-lite 89e146a)
    # - atomic_queue's superfluous "template" keywords are an error in current clang
    # - uint64_t is unsigned long long on Mac, so std::min(3UL, num_threads) cannot deduce a type
    # - odgi's Mac OpenMP flags assume MacPorts and CMake ignores CPPFLAGS, so Homebrew's paths
    #   (libomp is keg-only) go in through CFLAGS, CXXFLAGS and LDFLAGS
    # It links Homebrew's libomp and jemalloc.
    sed -i.bak -e 's/tree\.m_select\([01]\)/tree.m_bv_select\1/g' deps/sdsl-lite/include/sdsl/louds_tree.hpp
    sed -i.bak -e 's/std::min(3UL, num_threads)/std::min<uint64_t>(3, num_threads)/' src/subcommand/similarity_main.cpp
    ompPrefix=$(brew --prefix libomp)
    (export CC=clang CXX=clang++ \
            CFLAGS="${CFLAGS} ${CPPFLAGS} -I${ompPrefix}/include" \
            CXXFLAGS="${CXXFLAGS} ${CPPFLAGS} -I${ompPrefix}/include -Wno-missing-template-arg-list-after-template-kw" \
