     cmake -H. -Bbuild -DCMAKE_BUILD_TYPE=Generic -DCMAKE_C_FLAGS_GENERIC="-O3 ${CACTUS_ARCH_FLAGS}" -DCMAKE_CXX_FLAGS_GENERIC="-O3 ${CACTUS_ARCH_FLAGS}" && cmake --build build -- -j ${numcpu})
