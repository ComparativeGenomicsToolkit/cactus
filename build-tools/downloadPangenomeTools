git clone https://github.com/lh3/dna-nn.git
cd dna-nn
git checkout 2e6d242ae339457b985f50086e85194c3ce418b1
# hack in flags support
sed -i.bak -e 's/CFLAGS=/CFLAGS+=/' -e 's/LIBS=/LIBS+=/' Makefile
if [ -z ${CFLAGS+x} ]
then
	 make -j ${numcpu}
else
