# hal2vg, and the tools that ship with it: clip-vg, halRemoveDupes, halMergeChroms, halUnclip,
# filter-paf-deletions.  Built from a pinned commit rather than a release: it is self-contained
# through its submodules, and its own static build (make static) is what its releases use.
cd ${pangenomeBuildDir}
git clone https://github.com/ComparativeGenomicsToolkit/hal2vg.git
cd hal2vg
git checkout c1086ab021ada73b4826a7e1f1a3dbae8ea9c6ef
git submodule update --init --recursive
# makeBinRelease and the Dockerfile set ENABLE_PHYLOP, ENABLE_UDC and KENTSRC for cactus's own
# hal, whose phast and kent sit beside it.  hal2vg builds a second hal with neither, so those
# have to be kept from it, or it tries to build halPhyloP and to link kent's jkweb.a and
# samtabix and the build stops here.
if [[ $STATIC_CHECK -eq 1 ]]
then
	 env -u ENABLE_PHYLOP -u ENABLE_UDC -u KENTSRC make -j ${numcpu} static
else
	 env -u ENABLE_PHYLOP -u ENABLE_UDC -u KENTSRC make -j ${numcpu}
fi
for tool in hal2vg clip-vg halRemoveDupes halMergeChroms halUnclip filter-paf-deletions
do
	 if [[ $STATIC_CHECK -ne 1 || $(ldd ${tool} | grep so | wc -l) -eq 0 ]]
	 then
		  mv ${tool} ${binDir}
	 else
		  exit 1
	 fi
done

# vg
cd ${pangenomeBuildDir}
if [[ $isMac -eq 1 ]]
then
	 # There is no Mac release binary, so build it.  Its Makefile finds Homebrew's dependencies
	 # itself and chooses its own flags.
	 git clone --recursive --branch v1.78.0 https://github.com/vgteam/vg.git
	 cd vg
	 env -u CFLAGS -u CXXFLAGS -u CPPFLAGS -u LDFLAGS make -j ${numcpu}
	 # vg links some of the libraries it builds (libvgio, libhts, ...) from its own lib/ by absolute
	 # path.  Copy them to ${libDir}, have vg and each other find them through vg's rpath, and
	 # re-sign everything touched, since changing the load commands invalidates the signature.
	 vgLibs=$(otool -L bin/vg | awk -v lib="$(pwd)/lib/" 'index($1, lib) == 1 {print $1}')
	 for lib in ${vgLibs}
	 do
		  cp -L ${lib} ${libDir}/
		  install_name_tool -id @rpath/$(basename ${lib}) ${libDir}/$(basename ${lib})
	 done
	 for target in bin/vg $(for lib in ${vgLibs}; do echo ${libDir}/$(basename ${lib}); done)
	 do
		  for lib in ${vgLibs}
		  do
				install_name_tool -change ${lib} @rpath/$(basename ${lib}) ${target}
		  done
	 done
	 install_name_tool -add_rpath @executable_path/../lib bin/vg
	 for target in bin/vg $(for lib in ${vgLibs}; do echo ${libDir}/$(basename ${lib}); done)
	 do
		  codesign --force -s - ${target}
	 done
	 mv bin/vg ${binDir}
else
	 wget -nv --tries=5 --waitretry=3 --timeout=60 --retry-connrefused https://github.com/vgteam/vg/releases/download/v1.78.0/vg
	 chmod +x vg
	 if [[ $STATIC_CHECK -ne 1 || $(ldd vg | grep so | wc -l) -eq 0 ]]
	 then
