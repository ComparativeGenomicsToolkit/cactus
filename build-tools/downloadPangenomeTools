#!/bin/bash
# Download and statically build tools needed for cactus-refmap and cactus-graphmap.  They are
# - minimap2
# - minigraph
# - gfatools
# - dna-brnn
# - cactus-gfa-tools
# - samtools
# - bedtools
# The following tools are included to export and work with pangenome graph formats
# - hal2vg
# - vg
# The following tool is included for cactus-panpatch
# - panpatch
# The following tool is included for pangenome coverage/growth statistics (cactus-graphmap-join --panacus)
# - panacus
# If, updating any versions here, update the release notes as well
#
# all binaries get copied into cactus/bin
#
# On Mac (with the Homebrew dependencies in the README), the tools are built from source or taken
# from bioconda's Mac packages instead

# set this to one to make sure everything gets built statically (necessary for binary release)
STATIC_CHECK=$1

set -beEu -o pipefail

pangenomeBuildDir=$(pwd)/build-pangenome-tools
binDir=$(pwd)/bin
libDir=$(pwd)/lib
# just use cactusRootPath for now
dataDir=$(pwd)/src/cactus
CWD=$(pwd)
# works on MacOS and Linux
if [ -z ${numcpu+x} ]; then
	 numcpu=$(getconf _NPROCESSORS_ONLN)
fi

# Mac: there are no static builds, the Linux release binaries used below are no use, and Homebrew's
# prefix (boost, xz, libdeflate, ...) is not on Apple clang's default search paths
isMac=0
if [[ "$(uname -s)" == "Darwin" ]]; then
	 isMac=1
	 if [[ $STATIC_CHECK -eq 1 ]]; then
		  echo "ERROR: static builds are not supported on Mac" >&2
		  exit 1
	 fi
	 brewPrefix=$(brew --prefix)
	 export CPPFLAGS="${CPPFLAGS:-} -I${brewPrefix}/include"
	 export LDFLAGS="${LDFLAGS:-} -L${brewPrefix}/lib"
fi

# CMake 4 refuses projects that ask for compatibility with CMake < 3.5, which some of the bundled
# dependencies (sdsl-lite, DYNAMIC, ...) still do.  Older CMakes ignore this.
export CMAKE_POLICY_VERSION_MINIMUM=${CMAKE_POLICY_VERSION_MINIMUM:-3.5}

set -x

# detect jemalloc for faster memory allocation
# disable for legacy arch builds and on Mac (same as include.mk)
jemallocLib=""
if [[ -z ${CACTUS_LEGACY_ARCH+x} && "$(uname -s)" != "Darwin" ]]; then
    if pkg-config --exists jemalloc 2>/dev/null; then
        jemallocLib="-ljemalloc -lm"
    elif [ -f "${libDir}/libjemalloc.a" ]; then
        jemallocLib="-L${libDir} -ljemalloc -lm"
    fi
fi

# CPU baseline.  include.mk is the single source of truth; ask make for it rather than
# duplicating the arm/legacy/x86 selection here, where it would silently drift.  Without this
# nothing built by this script -- minigraph, minimap2, gfatools, samtools/bcftools --
# gets an arch flag at all: confirmed against the v3.3.0 tarball, where minigraph carried zero
# AVX2 in its own code, only glibc's runtime-dispatched string routines.
# MAKEFLAGS is cleared because "make binRelease" reaches this from inside a make recipe.
CACTUS_ARCH_FLAGS="${CACTUS_ARCH_FLAGS:-$(env -u MAKEFLAGS make -s -C "${CWD}" arch-flags)}"
if [ -z "${CACTUS_ARCH_FLAGS}" ]; then
    echo "ERROR: 'make arch-flags' returned nothing; cannot determine the CPU baseline." >&2
    exit 1
fi
# autoconf's AC_PROG_CC supplies its default "-g -O2" only when CFLAGS is *unset*.  Setting
# CFLAGS below to carry the arch flags therefore suppresses it, which would silently drop
# samtools, bcftools and htslib to -O0 in any build that had not already chosen a level --
# i.e. every non-release build, including the Docker image.  Choose the level here instead.
case " ${CFLAGS:-} " in *" -O"*) ;; *) CFLAGS="${CFLAGS:-} -O2" ;; esac
case " ${CXXFLAGS:-} " in *" -O"*) ;; *) CXXFLAGS="${CXXFLAGS:-} -O2" ;; esac
export CFLAGS="${CFLAGS} ${CACTUS_ARCH_FLAGS}"
export CXXFLAGS="${CXXFLAGS} ${CACTUS_ARCH_FLAGS}"

rm -rf ${pangenomeBuildDir}
mkdir -p ${pangenomeBuildDir}
mkdir -p ${binDir}
mkdir -p ${libDir}

# minimap2
# it has to be told to use NEON instead of SSE on ARM (detected as in include.mk)
if [[ -z ${arm+x} && "$(uname -m)" != "aarch64" && "$(uname -m)" != "arm64" ]]
then
    MINI_ARM_FLAGS=""
else
    MINI_ARM_FLAGS="arm_neon=1 aarch64=1"
fi
cd ${pangenomeBuildDir}
git clone https://github.com/lh3/minimap2.git
cd minimap2
git checkout v2.30
# hack in flags support (sed -i.bak, not -i, works with both GNU and BSD sed)
sed -i.bak -e 's/CFLAGS=/CFLAGS+=/' -e 's/LIBS=/LIBS+=/' Makefile
LIBS="${jemallocLib}" make -j ${numcpu} ${MINI_ARM_FLAGS}
if [[ $STATIC_CHECK -ne 1 || $(ldd minimap2 | grep so | wc -l) -eq 0 ]]
then
	 mv minimap2 ${binDir}
else
	 exit 1
fi

# minigraph
cd ${pangenomeBuildDir}
git clone https://github.com/glennhickey/minigraph.git
pushd minigraph
# ai-make-faster: 13 commits on lh3's 0.21-r606 (2f569eb). Byte-identical output by default;
# everything that can change a graph is behind an opt-in flag that defaults off. Chromosome-scale
# construction is ~4.5x faster, whole-genome ~2-2.9x, because stock runs one thread per query
# contig and so cannot use more than ~1 core on a chromosome or ~6.5 on a whole genome.
# wfa-scoring: on top of that, --wfa-pen to set the base-alignment penalties, which graphmap
# derives from the trained scoring model (<graphmap lastTrainMap>), with the closed-form alignment of
# N gaps extended to any penalties: without it, the pure-N gaps of a GRCh38 reference cost minutes
# per haplotype (200 s for the five largest on chr1 and chr9 at 8,11,1, against 9 ms with it).
# fix-reversed-cigar: a stock bug (since r508, lh3/minigraph#87) printed the cg of every record
# after a query's first reverse-strand stable-coordinate record with its ops reversed.
git checkout c59d03d23c3045515fba4790acdc3e8aa0e038db
# hack in flags support
sed -i.bak -e 's/CFLAGS=/CFLAGS+=/' -e 's/LIBS=/LIBS+=/' Makefile
LIBS="${jemallocLib}" make -j ${numcpu}
if [[ $STATIC_CHECK -ne 1 || $(ldd minigraph | grep so | wc -l) -eq 0 ]]
then
	 mv minigraph ${binDir}
else
	 exit 1
fi

# gfatools
cd ${pangenomeBuildDir}
git clone https://github.com/lh3/gfatools.git
cd gfatools
git checkout 39c54d5dfe4678d4cfb75b37bd27d4fb21f4de72
# hack in flags support
sed -i.bak -e 's/CFLAGS=/CFLAGS+=/' Makefile
make -j ${numcpu}
if [[ $STATIC_CHECK -ne 1 || $(ldd gfatools | grep so | wc -l) -eq 0 ]]
